{
  "vla": 1,
  "id": "vla-tour",
  "title": "Vibe Learn 新手导览",
  "code": "VLA101",
  "subtitle": "十分钟认识所有功能：组件、代码、高亮与 AI 回路",
  "description": "这门课本身就是用 **.vla / .vitent** 格式写成的。每一页演示一类功能——你看到的一切，AI 都能为任何主题生成。\n\n> 小技巧：在任何地方选中文字，都可以高亮、写注释，或者「问 AI」。",
  "color": "#d97757",
  "icon": "compass",
  "version": "1.1.0",
  "language": "zh-CN",
  "authors": [{ "name": "answer" }],
  "ai": {
    "context": "学习者第一次使用 Vibe Learn Anything，想了解这个软件能做什么。回答时多举软件里的具体例子。"
  },
  "units": [
    {
      "id": "week-0",
      "title": "认识界面",
      "chapters": [
        {
          "id": "w0-read",
          "title": "阅读与组件",
          "kind": "lesson",
          "description": "正文、公式、图表、布局组件、PDF / Word / 音频",
          "pages": [
            "content/w0/welcome.vitent",
            "content/w0/text-and-math.vitent",
            "content/w0/layout.vitent",
            "content/w0/media.vitent"
          ]
        },
        {
          "id": "w0-check",
          "title": "测验与记忆",
          "kind": "quiz",
          "description": "选择题、填空、代码排序、开放题、记忆卡片",
          "pages": [
            "content/w0/quizzes.vitent",
            "content/w0/flashcards.vitent"
          ]
        }
      ]
    },
    {
      "id": "week-1",
      "title": "动手写代码",
      "chapters": [
        {
          "id": "w1-workshop",
          "title": "代码工作区",
          "kind": "code",
          "pages": [
            "content/w1/snippets.vitent",
            "content/w1/workspace.vitent",
            "content/w1/terminal-actions.vitent",
            "content/w1/fullscreen.vitent"
          ]
        }
      ]
    },
    {
      "id": "week-2",
      "title": "和 AI 一起学",
      "chapters": [
        {
          "id": "w2-ai",
          "title": "高亮、提问与修改",
          "kind": "lesson",
          "pages": [
            "content/w2/highlight.vitent",
            "content/w2/custom-widget.vitent",
            "content/w2/buttons.vitent"
          ]
        }
      ]
    }
  ],
  "actions": {
    "node-version": {
      "type": "exec",
      "label": "查看 Node.js 版本",
      "command": "node --version",
      "output": "toast"
    },
    "open-manual": {
      "type": "ui",
      "command": "help"
    }
  },
  "buttons": [
    {
      "id": "manual",
      "slot": "topbar.right",
      "icon": "book-marked",
      "label": "AI 手册",
      "action": "open-manual",
      "order": 5
    }
  ]
}
